{
  "expo": {
    "name": "RASA EXPRESS",
    "slug": "rasa-express",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rasaexpress",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.we15.rasaexpress",
      "supportsTablet": true
    },
    "android": {
      "package": "com.we15.rasaexpress",
      "adaptiveIcon": {
        "backgroundColor": "#F26B1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F26B1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RASA EXPRESS uses your location during a delivery so the customer can see where you are."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
