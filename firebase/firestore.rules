rules_version = '2';

// Starter rules for RASA EXPRESS (coursework).
// Publish: Firebase console > Firestore Database > Rules > paste > Publish.
// Limitation: users choose their own role at sign-up (acceptable for a student project).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(r) {
      return signedIn() && myRole() == r;
    }

    function isOrderParty(order) {
      return signedIn() && (
        order.customerId == request.auth.uid ||
        order.cookId == request.auth.uid ||
        order.riderId == request.auth.uid
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /cooks/{cookId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == cookId;
      allow update: if signedIn() && (
        request.auth.uid == cookId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount'])
      );
    }

    match /dishes/{dishId} {
      allow read: if signedIn();
      allow create: if isRole('cook') && request.resource.data.cookId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.cookId == request.auth.uid;
    }

    match /carts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /orders/{orderId} {
      // Riders may see ready orders that nobody has accepted yet.
      allow read: if isOrderParty(resource.data) ||
        (isRole('rider') && resource.data.status == 'ready' && resource.data.riderId == null);
      allow create: if isRole('customer') && request.resource.data.customerId == request.auth.uid;
      allow update: if isOrderParty(resource.data) ||
        (isRole('rider') && resource.data.riderId == null);
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if isOrderParty(get(/databases/$(database)/documents/orders/$(orderId)).data);
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.customerId == request.auth.uid;
    }

    match /favourites/{favId} {
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /notifications/{noteId} {
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      // Any signed-in user may notify another (e.g. cook notifies customer).
      allow create: if signedIn();
    }

    match /payments/{paymentId} {
      allow read, update, delete: if signedIn() && resource.data.cookId == request.auth.uid;
      allow create: if isRole('cook') && request.resource.data.cookId == request.auth.uid;
    }
  }
}
